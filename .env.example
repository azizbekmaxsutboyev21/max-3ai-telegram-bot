# Telegram Bot Token (Telegram'da @BotFather orqali /newbot buyrug'i bilan olinadi)
BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API kaliti (https://aistudio.google.com/app/apikey orqali bepul olinadi)
# Maslahat: Kvota tugashini (429/503) oldini olish uchun bir nechta kalitni vergul bilan yozishingiz mumkin:
# GEMINI_API_KEYS=kalit1,kalit2,kalit3
GEMINI_API_KEY=your_gemini_api_key_here

# Model nomi (gemini-3.5-flash-lite tavsiya etiladi - chaqmoqdek tez va barqaror)
# Model band bo'lsa yoki 503 bersa, bot avtomatik zaxira modellarga o'tadi
GEMINI_MODEL=gemini-3.5-flash-lite

# Tizim yo'riqnomasi (AI ning xarakteri va roli)
SYSTEM_PROMPT=Siz do'stona, bilimdon va aqlli o'zbek AI yordamchisiz. Har qanday savollarga tushunarli, aniq va chiroyli javob berasiz.

# Yaratuvchi Telegram ID si (Faqat shu ID egasi botdan foydalana oladi)
CREATOR_ID=5772939710

# Botga kirish uchun maxfiy kod / PIN (Buni bot ichida /setcode orqali ham o'zgartira olasiz)
ACCESS_CODE=7777

# Telegram Shaxsiy Akkaunt (Userbot AI Agent) sozlamalari (https://my.telegram.org)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_STRING_SESSION=your_generated_string_session_here
